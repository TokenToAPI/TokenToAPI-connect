{
  "name": "tokentoapi-connect",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A minimal local API configurator for Claude and Codex",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TokenToAPI/TokenToAPI-connect.git"
  },
  "homepage": "https://github.com/TokenToAPI/TokenToAPI-connect",
  "bugs": "https://github.com/TokenToAPI/TokenToAPI-connect/issues",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build",
    "build:macos": "node scripts/build-macos.mjs",
    "build:windows": "node scripts/build-windows-portable.mjs",
    "package:windows": "node scripts/build-windows-portable.mjs --package-only",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test:stations": "node --experimental-strip-types --test tests/stations.test.ts",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:ui": "node --experimental-strip-types --test tests/*.test.ts",
    "test:lifecycle": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "24.1.3",
    "typescript": "^5.7.0",
    "vite": "^7.3.0",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@10.28.0"
}
